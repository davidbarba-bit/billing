# --- HTTP server -------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
# Pointing at the docker-compose postgres by default.
DATABASE_URL=postgres://lago:lago@localhost:5432/lago

# --- Auth --------------------------------------------------------------------
# Comma-separated list of API keys. Each key is a tenant/organization.
# Format: <api_key>:<organization_slug>[:<org_name>]
# Example with two orgs:
#   LAGO_API_KEYS=key_prod_123:numaris:Numaris Inc.,key_dev_456:acme
LAGO_API_KEYS=dev-key-1:default:Default Organization

# --- Webhooks ----------------------------------------------------------------
# Optional. If WEBHOOK_URL is set, invoice/credit-note events are POSTed there.
# WEBHOOK_URL=https://example.com/webhooks/lago
WEBHOOK_SIGNATURE_KEY=replace-me-with-a-random-secret

# --- Background jobs --------------------------------------------------------
# How often (ms) the period-closing cron runs. 0 disables the cron (useful in tests).
PERIOD_CLOSE_INTERVAL_MS=3600000
